# Copy to .env for local overrides (the app runs fine with all of these unset).

# Core Django
# SECRET_KEY=replace-with-a-long-random-string-in-production
# DEBUG=true
# ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://your-app.example.com

# Persistent storage (point at a mounted volume in production).
# MEDIA_ROOT=/data/media
# SQLITE_PATH=/data/db.sqlite3

# AI document analysis.
# Leave ANTHROPIC_API_KEY unset to run the deterministic stub analyzer.
# Set it to switch on the real Anthropic-backed (sdk) analysis (prompt-cached).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5

# Analyzer backend: stub | sdk | cli. Empty auto-resolves to sdk when a key is
# present, else stub (never cli). `cli` is a dev-only convenience that reuses
# your local `claude` login; never set it in production.
# DOCUMENT_ANALYZER_BACKEND=cli
# CLAUDE_CLI_PATH=claude
